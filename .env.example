# MongoDB MCP Server 配置

# MongoDB 连接字符串
MONGODB_URI=mongodb://localhost:27017

# 配置数据库名称
MONGODB_DATABASE=config_db

# 配置集合名称
MONGODB_COLLECTION=ConfigModules

# 知识库数据库名称
KNOWLEDGE_DATABASE=knowledge

# 知识库集合名称（MCPs、Memories、Rules、Skills）
KNOWLEDGE_COLLECTION=context

# HTTP 服务端口（仅 HTTP 模式）
HTTP_PORT=3100

# 启用 Change Stream（需要 MongoDB Replica Set）
ENABLE_CHANGE_STREAM=false

# 日志级别：debug | info | warn | error
LOG_LEVEL=info
