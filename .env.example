# ================================
# Mongo-MCP 环境变量配置模板
# ================================

# MongoDB 连接配置
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=mongo_mcp
MONGO_COLLECTION=knowledge

# 用户标识
# USER_ID: 用户唯一标识，用于数据隔离
# DEVICE_ID: 设备标识，留空则自动生成
# IDE_SOURCE: IDE 来源 (qoder/trae/cursor/windsurf/vscode/manual/other)
USER_ID=default
DEVICE_ID=
IDE_SOURCE=qoder

# 功能开关
# ENABLE_EMBEDDING: 是否启用向量嵌入（需要额外内存）
# ENABLE_CHANGE_STREAM: 是否启用 MongoDB Change Stream
ENABLE_EMBEDDING=false
ENABLE_CHANGE_STREAM=false

# 日志配置
# LOG_LEVEL: debug/info/warn/error
LOG_LEVEL=info
