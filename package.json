{
  "name": "mongo-mcp",
  "version": "2.0.0",
  "description": "MongoDB MCP Server - 跨 IDE 知识库管理工具，支持记忆、技能、规则、MCP、经验、命令、上下文、工作流等",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "mongo-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "mongodb",
    "knowledge",
    "memory",
    "qoder",
    "trae",
    "cursor",
    "ide",
    "cross-platform"
  ],
  "author": "fengyongtao",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@xenova/transformers": "^2.17.2",
    "chokidar": "^3.6.0",
    "lodash": "^4.17.23",
    "mongodb": "^6.3.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.23",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.55.0",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
