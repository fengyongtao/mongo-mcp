{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "此文件展示如何在各种 IDE 中配置 mongo-mcp",
  
  "qoder": {
    "$comment": "Qoder IDE 配置示例",
    "mcpServers": {
      "mongo-mcp": {
        "command": "npx",
        "args": ["-y", "mongo-mcp"],
        "env": {
          "MONGO_URI": "mongodb://localhost:27017",
          "MONGO_DATABASE": "qoder_knowledge",
          "USER_ID": "your@email.com",
          "DEVICE_ID": "qoder-desktop",
          "IDE_SOURCE": "qoder",
          "ENABLE_EMBEDDING": "false",
          "LOG_LEVEL": "info"
        }
      }
    }
  },

  "cursor": {
    "$comment": "Cursor IDE 配置示例（~/.cursor/mcp.json）",
    "mcpServers": {
      "mongo-mcp": {
        "command": "npx",
        "args": ["-y", "mongo-mcp"],
        "env": {
          "MONGO_URI": "mongodb://localhost:27017",
          "MONGO_DATABASE": "cursor_knowledge",
          "USER_ID": "your@email.com",
          "DEVICE_ID": "cursor-mac",
          "IDE_SOURCE": "cursor"
        }
      }
    }
  },

  "vscode": {
    "$comment": "VS Code 配置示例（.vscode/settings.json）",
    "mcp.servers": {
      "mongo-mcp": {
        "command": "npx",
        "args": ["-y", "mongo-mcp"],
        "env": {
          "MONGO_URI": "mongodb://localhost:27017",
          "MONGO_DATABASE": "vscode_knowledge",
          "USER_ID": "your@email.com",
          "IDE_SOURCE": "vscode"
        }
      }
    }
  },

  "local_development": {
    "$comment": "本地开发配置示例（使用本地构建）",
    "mcpServers": {
      "mongo-mcp": {
        "command": "node",
        "args": ["/path/to/mongo-mcp/dist/index.js"],
        "env": {
          "MONGO_URI": "mongodb://localhost:27017",
          "MONGO_DATABASE": "dev_knowledge",
          "USER_ID": "developer",
          "DEVICE_ID": "dev-machine",
          "IDE_SOURCE": "manual",
          "ENABLE_EMBEDDING": "true",
          "LOG_LEVEL": "debug"
        }
      }
    }
  },

  "shared_cloud": {
    "$comment": "云数据库共享配置示例（多设备同步）",
    "mcpServers": {
      "mongo-mcp": {
        "command": "npx",
        "args": ["-y", "mongo-mcp"],
        "env": {
          "MONGO_URI": "mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority",
          "MONGO_DATABASE": "shared_knowledge",
          "USER_ID": "team@company.com",
          "DEVICE_ID": "office-mac",
          "IDE_SOURCE": "qoder",
          "ENABLE_EMBEDDING": "true"
        }
      }
    }
  }
}
